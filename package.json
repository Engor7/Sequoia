{
  "name": "sequoia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "generate:motion-presets": "node scripts/generate-motion-presets.mjs && node scripts/generate-color-presets.mjs",
    "typecheck": "tsc -b",
