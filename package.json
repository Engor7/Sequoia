  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sass": "^1.93.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
